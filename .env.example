# ---- アプリ ----
# 公開 URL（OAuth のリダイレクト先と Pub/Sub push の audience に使う）
APP_BASE_URL=https://mail.yusando.com
# ログインを許可する Google Workspace ドメイン
ALLOWED_DOMAIN=yusando.com
# 最初にログインできる管理者（カンマ区切り）。以後の利用者は設定画面で追加する
ADMIN_EMAILS=isozaki@yusando.com
# セッション署名用（32文字以上のランダム文字列）
SESSION_SECRET=
# Google リフレッシュトークン暗号化キー（32バイトを base64 で。 openssl rand -base64 32）
TOKEN_ENCRYPTION_KEY=
# cron エンドポイント（/api/cron/*）用の共有シークレット
CRON_SECRET=

# ---- データベース ----
DATABASE_URL=postgres://user:pass@localhost:5432/yusando_mail

# ---- Google ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Gmail の受信通知先 Pub/Sub トピック（projects/<project>/topics/<topic>）
GMAIL_PUBSUB_TOPIC=
# Pub/Sub push サブスクリプションに設定したサービスアカウントのメール
PUBSUB_PUSH_SERVICE_ACCOUNT=

# ---- Claude ----
ANTHROPIC_API_KEY=

# ---- Shopify（任意。設定すると注文・配送の下書きに注文情報を使う） ----
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ADMIN_TOKEN=

# ---- モデル（任意。既定は仕様書 5章の表） ----
# CLAUDE_DRAFT_MODEL=claude-opus-5
# CLAUDE_CLASSIFY_MODEL=claude-haiku-4-5
# CLAUDE_SUMMARY_MODEL=claude-haiku-4-5
# SHOPIFY_API_VERSION=2026-07

# ---- freee 会計（任意。経理のメールの添付をファイルボックスに送る） ----
# freee アプリストアの開発者ページでアプリを作り、コールバック URL に <APP_BASE_URL>/api/freee/callback を入れる
FREEE_CLIENT_ID=
FREEE_CLIENT_SECRET=

# ---- 通知（任意。npx web-push generate-vapid-keys で作る） ----
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:isozaki@yusando.com
